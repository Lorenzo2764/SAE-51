; /etc/bind/db.203.0.113
; Zone inverse du réseau 203.0.113.0/24

$TTL 3600
@       IN  SOA ns1.operateur.lab. admin.operateur.lab. (
                2026111101  ; serial (AAAAMMJJNN)
                3600        ; refresh
                900         ; retry
                604800      ; expire
                300 )       ; TTL négatif

@	IN  NS  ns1.operateur.lab.
1       IN  PTR ns1.operateur.lab.
1       IN  PTR sftp.operateur.lab.
1	IN  PTR portail.operateur.lab.
