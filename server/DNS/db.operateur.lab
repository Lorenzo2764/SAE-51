; /etc/bind/db.operateur.lab
; Zone directe operateur.lab

$TTL 3600
@	IN	SOA	ns1.operateur.lab.	admin.operateur.lab. (
		2026111101	; serial (AAAAMMJJNN)
		3600		; refresh
		900		; retry
		604800		; expire
		300 )		; TTL négatif
;
@	IN	NS	ns1.operateur.lab.
ns1	IN	A	203.0.113.1
sftp	IN	A	203.0.113.1
portail	IN	A	203.0.113.1
