[Unit]
Description=Portail client (FastAPI)
After=network.target postgresql.service

[Service]
User=provisioning
Group=provisioning
WorkingDirectory=/opt/provisioning-web
EnvironmentFile=/etc/provisioning-web.env
# Un seul processus : la limitation des tentatives de connexion est en mémoire
ExecStart=/opt/provisioning-web/venv/bin/uvicorn portail.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/provisioning/configs

[Install]
WantedBy=multi-user.target
